<?xml version="1.0" encoding="utf-8"?>
<!--
    Etapa 6 · Seguridad de la app "Tableros DACSA".
    * Todos los usuarios internos ven los tableros de sus grupos (o los que no
      tienen grupos).
    * El grupo "Tableros DACSA: administrador" los crea y configura. Los
      administradores de Odoo lo tienen automáticamente.
-->
<odoo>
    <record id="group_dashboard_manager" model="res.groups">
        <field name="name">Tableros DACSA: administrador</field>
        <field name="comment">Crea y configura los tableros, sus filtros, dominios y fórmulas.</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('custom_business_reports.group_dashboard_manager'))]"/>
    </record>

    <record id="rule_business_dashboard_user" model="ir.rule">
        <field name="name">Tableros: solo los de mis grupos</field>
        <field name="model_id" ref="model_business_dashboard"/>
        <field name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_business_dashboard_manager" model="ir.rule">
        <field name="name">Tableros: todos (administrador)</field>
        <field name="model_id" ref="model_business_dashboard"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('custom_business_reports.group_dashboard_manager'))]"/>
    </record>

    <!-- 19.0.8.0.0 · Metas de venta: cada empresa ve las suyas -->
    <record id="rule_business_sales_goal_company" model="ir.rule">
        <field name="name">Metas de venta: empresas permitidas</field>
        <field name="model_id" ref="model_business_sales_goal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

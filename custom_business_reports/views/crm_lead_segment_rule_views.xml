<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas Calidad del lead -> Segmento (editables sin programar). -->
<odoo>
    <record id="crm_lead_segment_rule_view_list" model="ir.ui.view">
        <field name="name">crm.lead.segment.rule.list</field>
        <field name="model">crm.lead.segment.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <header>
                    <!-- Útil si se modificó la Calidad del lead por importación o SQL -->
                    <button name="action_recompute_segments" type="object"
                            string="Recalcular segmentos" display="always"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="quality_value"/>
                <field name="segment"/>
            </list>
        </field>
    </record>

    <record id="crm_lead_segment_rule_action" model="ir.actions.act_window">
        <field name="name">Segmentos por calidad del lead</field>
        <field name="res_model">crm.lead.segment.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a qué segmento pertenece cada calidad del lead</p>
            <p>Por ejemplo: 1. Idóneo y 2. Bueno = Sin recompra; 4. Recompra = Recompra.</p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Etapa 2 · Seguimiento comercial.
    Vistas y acciones del menú CRM › Reportes › Seguimiento comercial:
    gráficas (invitaciones, ganados/perdidos, venta por mes de cierre) y
    listados por estatus. Todas excluyen "Ganados en 0's".
-->
<odoo>
    <!-- ================================================================
         Vistas compartidas
         ================================================================ -->

    <!-- Lista para todos los listados: columnas pensadas para revisar y
         exportar a Excel. Las columnas que no aplican se pueden ocultar. -->
    <record id="crm_lead_view_list_business_reports" model="ir.ui.view">
        <field name="name">crm.lead.list.business_reports</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Seguimiento comercial" create="0"
                  decoration-muted="report_stage_group == 'excluido'">
                <field name="report_stage_group" column_invisible="1"/>
                <field name="create_date" string="Creado" widget="date"/>
                <field name="date_closed" string="Cierre" widget="date" optional="show"/>
                <field name="report_age_days" string="Días" optional="hide"
                       decoration-danger="report_age_days &gt; 90"/>
                <field name="partner_id" string="Cliente"/>
                <field name="name" string="Proyecto"/>
                <field name="report_segment" widget="badge"
                       decoration-info="report_segment == 'sin_recompra'"
                       decoration-warning="report_segment == 'recompra'"
                       decoration-muted="report_segment == 'inadecuado'"/>
                <field name="stage_id" optional="show"/>
                <field name="user_id" optional="hide" widget="many2one_avatar_user"/>
                <field name="lost_reason_id" optional="hide"/>
                <field name="report_last_move_date" optional="hide"/>
                <field name="report_idle_days" optional="hide"/>
                <field name="report_idle_level" widget="badge" optional="hide"
                       decoration-success="report_idle_level == 'ok'"
                       decoration-warning="report_idle_level == 'warning'"
                       decoration-danger="report_idle_level == 'late'"/>
                <field name="company_currency" column_invisible="1"/>
                <field name="expected_revenue" string="Monto" sum="Total"
                       widget="monetary" options="{'currency_field': 'company_currency'}"/>
            </list>
        </field>
    </record>

    <!-- Gráfica: invitaciones a cotizar por mes de creación, apiladas por
         atendidas (Sin recompra / Recompra) y no atendidas. -->
    <record id="crm_lead_view_graph_invitations" model="ir.ui.view">
        <field name="name">crm.lead.graph.invitations</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <graph string="Invitaciones a cotizar" type="bar" stacked="1">
                <field name="create_date" interval="month"/>
                <field name="report_invitation_status"/>
            </graph>
        </field>
    </record>

    <!-- Gráfica: ganados y perdidos por mes de cierre y segmento. -->
    <record id="crm_lead_view_graph_close_status" model="ir.ui.view">
        <field name="name">crm.lead.graph.close_status</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <graph string="Ganados y perdidos" type="bar" stacked="1">
                <field name="date_closed" interval="month"/>
                <field name="report_close_status"/>
            </graph>
        </field>
    </record>

    <!-- Gráfica: venta (monto ganado) por mes de cierre y segmento. -->
    <record id="crm_lead_view_graph_sales" model="ir.ui.view">
        <field name="name">crm.lead.graph.sales_by_close</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <graph string="Venta por mes de cierre" type="bar" stacked="1">
                <field name="date_closed" interval="month"/>
                <field name="report_segment"/>
                <field name="expected_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Tabla dinámica: venta por mes de cierre (filas) y segmento (columnas). -->
    <record id="crm_lead_view_pivot_sales" model="ir.ui.view">
        <field name="name">crm.lead.pivot.sales_by_close</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Venta por mes de cierre">
                <field name="date_closed" interval="month" type="row"/>
                <field name="report_segment" type="col"/>
                <field name="expected_revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Tabla dinámica del embudo: estatus de invitación por segmento. -->
    <record id="crm_lead_view_pivot_invitations" model="ir.ui.view">
        <field name="name">crm.lead.pivot.invitations</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Invitaciones a cotizar">
                <field name="create_date" interval="quarter" type="row"/>
                <field name="report_invitation_status" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- ================================================================
         Gráficas
         ================================================================ -->

    <record id="action_business_report_invitations" model="ir.actions.act_window">
        <field name="name">Invitaciones a cotizar</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('type', '=', 'opportunity'), ('report_invitation_status', '!=', False)]</field>
        <!-- active_test: incluye las perdidas, que Odoo archiva -->
        <field name="context">{'active_test': False}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'graph', 'view_id': ref('crm_lead_view_graph_invitations')}),
            Command.create({'view_mode': 'pivot', 'view_id': ref('crm_lead_view_pivot_invitations')}),
            Command.create({'view_mode': 'list', 'view_id': ref('crm_lead_view_list_business_reports')})]"/>
        <field name="help" type="html"><p>Leads que llegaron a cotizarse (atendidos) o que se declinaron (no atendidos), por mes de creación.</p></field>
    </record>

    <record id="action_business_report_close_status" model="ir.actions.act_window">
        <field name="name">Ganados y perdidos</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph,list</field>
        <field name="domain">[('type', '=', 'opportunity'), ('report_close_status', '!=', False)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'graph', 'view_id': ref('crm_lead_view_graph_close_status')}),
            Command.create({'view_mode': 'list', 'view_id': ref('crm_lead_view_list_business_reports')})]"/>
        <field name="help" type="html"><p>Cotizaciones ganadas y perdidas por mes de cierre, separadas por segmento.</p></field>
    </record>

    <record id="action_business_report_sales" model="ir.actions.act_window">
        <field name="name">Venta por mes de cierre</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('type', '=', 'opportunity'), ('won_status', '=', 'won'), ('report_stage_group', '!=', 'excluido')]</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'graph', 'view_id': ref('crm_lead_view_graph_sales')}),
            Command.create({'view_mode': 'pivot', 'view_id': ref('crm_lead_view_pivot_sales')}),
            Command.create({'view_mode': 'list', 'view_id': ref('crm_lead_view_list_business_reports')})]"/>
        <field name="help" type="html"><p>Monto de las oportunidades ganadas, en el mes de su fecha de cierre.</p></field>
    </record>

    <!-- ================================================================
         Listados por estatus (todos usan la misma lista)
         ================================================================ -->

    <record id="action_business_list_won" model="ir.actions.act_window">
        <field name="name">Proyectos ganados</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_lead_view_list_business_reports"/>
        <field name="domain">[('type', '=', 'opportunity'), ('won_status', '=', 'won'), ('report_stage_group', '!=', 'excluido')]</field>
        <!-- Agrupado por segmento: una tabla para Sin recompra y otra para Recompra -->
        <field name="context">{'group_by': ['report_segment']}</field>
    </record>

    <record id="action_business_list_lost" model="ir.actions.act_window">
        <field name="name">Proyectos perdidos</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_lead_view_list_business_reports"/>
        <field name="domain">[('type', '=', 'opportunity'), ('won_status', '=', 'lost')]</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="action_business_list_cancelled" model="ir.actions.act_window">
        <field name="name">Proyectos cancelados</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_lead_view_list_business_reports"/>
        <field name="domain">[('type', '=', 'opportunity'), ('stage_id.report_close_on_enter', '=', True)]</field>
    </record>

    <record id="action_business_list_paused" model="ir.actions.act_window">
        <field name="name">Proyectos en pausa</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_lead_view_list_business_reports"/>
        <field name="domain">[('type', '=', 'opportunity'), ('report_open_status', '=', 'pausa'), ('won_status', '=', 'pending')]</field>
    </record>

    <record id="action_business_list_pipeline" model="ir.actions.act_window">
        <field name="name">Pipeline abierto (enviadas)</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_lead_view_list_business_reports"/>
        <field name="domain">[('type', '=', 'opportunity'), ('report_open_status', '=', 'enviada'), ('won_status', '=', 'pending')]</field>
    </record>

    <record id="action_business_list_to_send" model="ir.actions.act_window">
        <field name="name">Invitaciones por enviar</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_lead_view_list_business_reports"/>
        <field name="domain">[('type', '=', 'opportunity'), ('report_stage_group', '=', 'por_enviar'), ('won_status', '=', 'pending')]</field>
    </record>

    <record id="action_business_list_prospecting" model="ir.actions.act_window">
        <field name="name">Prospección</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_lead_view_list_business_reports"/>
        <field name="domain">[('type', '=', 'opportunity'), ('report_stage_group', '=', 'prospeccion')]</field>
        <field name="context">{'group_by': ['stage_id']}</field>
    </record>

    <record id="action_business_list_idle" model="ir.actions.act_window">
        <field name="name">Oportunidades lentas</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_lead_view_list_business_reports"/>
        <!-- Abiertas y sin etapas de cierre; se abre con el filtro de 90 días -->
        <field name="domain">[('type', '=', 'opportunity'), ('won_status', '=', 'pending'), ('report_stage_group', 'in', ['prospeccion', 'por_enviar', 'cotizado']), ('stage_id.report_close_on_enter', '=', False)]</field>
        <field name="context">{'search_default_ccr_idle_90': 1}</field>
    </record>
</odoo>

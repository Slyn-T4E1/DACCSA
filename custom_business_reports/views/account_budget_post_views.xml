<?xml version="1.0" encoding="utf-8"?>
<!-- Etapa 3: tipo de partida en las posiciones presupuestarias. -->
<odoo>
    <record id="view_budget_post_form_business_reports" model="ir.ui.view">
        <field name="name">account.budget.post.form.business_reports</field>
        <field name="model">account.budget.post</field>
        <field name="inherit_id" ref="base_account_budget.view_budget_post_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="report_partida"/>
            </xpath>
        </field>
    </record>

    <record id="view_budget_post_tree_business_reports" model="ir.ui.view">
        <field name="name">account.budget.post.list.business_reports</field>
        <field name="model">account.budget.post</field>
        <field name="inherit_id" ref="base_account_budget.view_budget_post_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="report_partida" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Lista editable para revisar y corregir el tipo de partida de todas
         las posiciones (Proyecto > Configuración > Partidas de posiciones). -->
    <record id="view_budget_post_partida_list" model="ir.ui.view">
        <field name="name">account.budget.post.list.partida</field>
        <field name="model">account.budget.post</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0" string="Partidas de posiciones presupuestarias">
                <field name="name" readonly="1"/>
                <field name="report_partida"/>
                <field name="account_ids" widget="many2many_tags" readonly="1" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_budget_post_partida_search" model="ir.ui.view">
        <field name="name">account.budget.post.search.partida</field>
        <field name="model">account.budget.post</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Sin tipo de partida" name="no_partida" domain="[('report_partida', '=', False)]"/>
                <group>
                    <filter string="Tipo de partida" name="group_partida" context="{'group_by': 'report_partida'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_budget_post_partida" model="ir.actions.act_window">
        <field name="name">Partidas de posiciones presupuestarias</field>
        <field name="res_model">account.budget.post</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_budget_post_partida_list"/>
        <field name="search_view_id" ref="view_budget_post_partida_search"/>
        <field name="context">{'search_default_group_partida': 1}</field>
    </record>
</odoo>
